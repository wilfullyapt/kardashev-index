# Render / local
DATABASE_URL=postgresql://user:pass@localhost:5432/kardashev_index

# Admin (hashed password — generate with: python -c "from passlib.hash import bcrypt; print(bcrypt.hash('yourpass'))")
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=$2b$12$...  # bcrypt hash

# LLM (for judging — use your provider key)
OPENAI_API_KEY=sk-...
# Or GROK_API_KEY if switching

# Optional
RENDER=1
SECRET_KEY=change-me-for-sessions