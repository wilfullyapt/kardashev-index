# kardashev-index — environment variables (copy to .env for local runs; .env is loaded by python-dotenv).
# On Render these are set on the service (secrets with `sync: false` in render.yaml).
# Values below are defaults or placeholders. Never commit real secrets.

# ---- Core ---------------------------------------------------------------------
# Postgres in production (Render injects it). Local default if unset: sqlite:///./test.db
DATABASE_URL=postgresql://kardashev:change_me@localhost:5432/kardashev_index
# Session signing key (Render: generateValue). Required in production.
SECRET_KEY=change-me-long-random-string

# ---- Admin login -------------------------------------------------------------
ADMIN_EMAIL=admin@example.com
# python -c "from passlib.hash import bcrypt; print(bcrypt.hash('yourpass'))"
ADMIN_PASSWORD_HASH=$2b$12$REPLACE_WITH_REAL_BCRYPT_HASH

# ---- Hermes (internal API key for /internal/*) -------------------------------
HERMES_API_KEY=change-me

# ---- xAI (judgment runs; paid API) -------------------------------------------
# Required for runs; without it runs fail with config_error. GROK_API_KEY is accepted as an alias.
XAI_API_KEY=
# XAI_MODEL=grok-4.3
# XAI_BASE_URL=https://api.x.ai/v1
# XAI_TIMEOUT_S=120
# XAI_SEARCH_TIMEOUT_S=240
# In-call retries for 408/409/429/5xx/timeouts (honors Retry-After), and the max backoff wait
# XAI_MAX_RETRIES=3
# XAI_BACKOFF_MAX_S=60

# ---- SEC EDGAR -----------------------------------------------------------------
# Contact string sent as User-Agent to sec.gov (SEC requires it). Without it the EDGAR stage
# (XBRL revenue/capex, ticker cross-check) is skipped and admin pages show a config alert.
SEC_EDGAR_USER_AGENT="Kardashev Index you@example.com"

# ---- Budget and research limits (per run) --------------------------------------
# Hard per-run budget in USD, checked before every paid call
# JUDGE_MAX_COST_USD=0.40
# Budget kept back for the judge when gathering stages reach the cap
# JUDGE_RESERVE_USD=0.04
# JUDGE_RESOLVE_MAX_SEARCHES=3
# JUDGE_RESEARCH_MAX_SEARCHES=8
# JUDGE_MAX_SOURCES=12
# Output token limits per stage
# JUDGE_RESOLVE_MAX_TOKENS=8000
# JUDGE_RESEARCH_MAX_TOKENS=16000
# JUDGE_EXTRACT_MAX_TOKENS=16000
# JUDGE_JUDGE_MAX_TOKENS=8000
# JUDGE_MAX_ATTEMPTS=2

# ---- Fetching and extraction ------------------------------------------------------
# FETCH_TIMEOUT_S=20
# FETCH_MAX_BYTES=30000000
# Retries for 429/5xx/timeouts
# FETCH_RETRIES=2
# Wayback Machine fallback for 401/403/404/410/451 (1 = on)
# FETCH_WAYBACK=1
# Fetched text stored per source (quotes are re-verified against it on resume)
# SNAPSHOT_MAX_CHARS=1000000
# EXTRACT_MAX_CHARS=64000
# EXTRACT_PER_SOURCE_CHARS=20000

# ---- Identity and ranking rules ---------------------------------------------------
# Reuse a confidently resolved company identity for this many days
# IDENTITY_TTL_DAYS=90
# IDENTITY_MIN_CONFIDENCE=0.75
# Count energy generated at own plants as energy throughput
# ENERGY_COUNT_GENERATION=1
# RANK_MIN_COVERAGE=0.6
# RANK_MIN_MEASURED=0.3
# Rank on the remaining 70% when no energy figure is disclosed (flagged, confidence x0.8)
# RANK_ENERGY_UNDISCLOSED=1
# RANK_ENERGY_UNDISCLOSED_MIN_SOURCES=3

# ---- Worker, automatic retries, daily sweep ----------------------------------------
# In-process worker (set 0 to disable, e.g. for previews or a second instance)
# WORKER_ENABLED=1
# WORKER_POLL_S=15
# WORKER_HEARTBEAT_S=20
# Runs with an older heartbeat are re-queued and resume from their checkpoint
# WORKER_STALE_S=180
# Seconds to let a running stage finish on shutdown (keep below render.yaml maxShutdownDelaySeconds)
# WORKER_DRAIN_S=45
# Automatic retries of transient failures, at these delays in minutes, up to RUN_MAX_ATTEMPTS
# RUN_AUTO_RETRY=1
# RUN_MAX_ATTEMPTS=4
# RUN_RETRY_DELAYS_MIN=2,10,60
# Daily re-run of withheld / not-ranked companies older than SWEEP_MIN_AGE_DAYS, capped per day (paid)
# SWEEP_ENABLED=1
# SWEEP_HOUR_UTC=10
# SWEEP_MIN_AGE_DAYS=7
# SWEEP_DAILY_COST_USD=2.0
# SWEEP_EST_RUN_USD=0.35

# ---- Alerts -----------------------------------------------------------------------
# Optional JSON webhook (Slack-compatible "text") for failed / degraded / stuck runs
# ALERT_WEBHOOK_URL=
